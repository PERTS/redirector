{
  "name": "perts_me",
  "description": "PERTS participation portal redirector",
  "version": "0.0.1",
  "engines": {
    "node": "20.19.5"
  },
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git://github.com/PERTS/perts_me.git"
  },
  "scripts": {
    "build": "./build_app_yaml.sh",
    "server": "export $(cat .env | xargs) && gunicorn -b :8080 main:app",
    "start": "if [ ! -f \".env\" ]; then echo \"Can't start app: .env is missing. Run build_app_yaml.sh first\"; else npm run server; fi"
  },
  "dependencies": {}
}
